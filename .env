# 企业任务管理系统 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件不应提交到版本控制系统

# ==================== 数据库配置 ====================
# MySQL
MYSQL_ROOT_PASSWORD=Lxh17306642597
MYSQL_DATABASE=task_project
MYSQL_USER=task_user
MYSQL_PASSWORD=task_password
MYSQL_PORT=3306

# MongoDB
MONGO_USERNAME=admin
MONGO_PASSWORD=admin123
MONGO_DATABASE=task_project
MONGO_PORT=27017

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Etcd 服务发现
ETCD_PORT=2379
ETCD_HOSTS=127.0.0.1:2379

# ==================== 安全配置 ====================
# JWT密钥 - 请使用强随机字符串
JWT_SECRET_KEY=dev_secret_key_1234567890_for_testing_only

# ==================== 腾讯云COS配置 ====================
TENCENT_CLOUD_SECRET_ID=your_tencent_cloud_secret_id
TENCENT_CLOUD_SECRET_KEY=your_tencent_cloud_secret_key
TENCENT_CLOUD_COS_BUCKET=your-bucket-name
TENCENT_CLOUD_COS_REGION=ap-guangzhou

# ==================== 邮件配置 ====================
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@qq.com
EMAIL_PASSWORD=your_email_auth_code

# ==================== AI服务配置 ====================
# 智谱AI GLM
GLM_API_KEY=your_glm_api_key

# ==================== 限流配置 ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_API=100

# ==================== 服务端口 ====================
BACKEND_PORT=8888
